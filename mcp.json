{
  "mcpServers": {
    "discord": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CURSOR_PLUGIN_ROOT}/server/index.mjs"
      ],
      "env": {
        "DISCORD_BOT_TOKEN": "${DISCORD_BOT_TOKEN}",
        "XAI_API_KEY": "${XAI_API_KEY:-}",
        "ELEVENLABS_API_KEY": "${ELEVENLABS_API_KEY:-}",
        "ELEVENLABS_AGENT_ID": "${ELEVENLABS_AGENT_ID:-}",
        "ELEVENLABS_VOICE_ID": "${ELEVENLABS_VOICE_ID:-}",
        "REPLY_MODE": "${REPLY_MODE:-agent}",
        "ROUTINE_WEBHOOK_URL": "${ROUTINE_WEBHOOK_URL:-}",
        "ROUTINE_WEBHOOK_KEY": "${ROUTINE_WEBHOOK_KEY:-}",
        "DISCORD_DEFAULT_CHANNEL_ID": "${DISCORD_DEFAULT_CHANNEL_ID:-}",
        "ALLOWED_IDS": "${ALLOWED_IDS:-}",
        "ALLOWED_CHANNEL_IDS": "${ALLOWED_CHANNEL_IDS:-}",
        "LISTEN_CHANNEL_IDS": "${LISTEN_CHANNEL_IDS:-}"
      }
    }
  }
}
