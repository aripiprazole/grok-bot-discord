# Local testing only (npm run dev). In Cursor or Grok Bot, set these in the plugin settings instead.
# Discord Developer Portal → your app → Bot → Reset Token. Also turn on Message Content Intent there.
DISCORD_BOT_TOKEN=
# Optional: REPLY_MODE=instant only. https://console.x.ai → API Keys
XAI_API_KEY=
# Optional: voice calls. https://elevenlabs.io → Developers → API keys
ELEVENLABS_API_KEY=
# Optional: an existing ElevenLabs agent and voice. Empty creates an agent named grok-bot-discord.
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
# agent (your agent answers through the inbox) or instant (Grok answers right away; needs XAI_API_KEY)
REPLY_MODE=agent
# Optional: your wake-up routine's webhook (trigger "When a webhook fires").
ROUTINE_WEBHOOK_URL=
ROUTINE_WEBHOOK_KEY=
# Optional: comma-separated user/role IDs allowed to use the bot, and always-reply channel IDs.
ALLOWED_IDS=
LISTEN_CHANNEL_IDS=
